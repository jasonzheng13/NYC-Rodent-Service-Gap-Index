{
  "datasets": [
    {
      "name": "zip_main",
      "displayName": "ZIP Service Gap (Selected)",
      "queryLines": [
        "WITH params AS (\n",
        "  SELECT\n",
        "    :zip AS search_zip\n",
        ")\n",
        "SELECT\n",
        "  COALESCE(z.zip, p.search_zip) AS zip,\n",
        "  z.borough,\n",
        "  z.complaints,\n",
        "  z.complaints_capped,\n",
        "  z.top_address_share,\n",
        "  z.no_show_rate,\n",
        "  z.rodent_evidence_rate,\n",
        "  z.sgi,\n",
        "  z.sgi_rank,\n",
        "  z.ranked_zip_count,\n",
        "  z.is_sparse,\n",
        "  z.restaurants,\n",
        "  z.era2_median_days_to_close,\n",
        "  CASE\n",
        "    WHEN z.zip IS NULL THEN 'Not an NYC ZIP code.'\n",
        "    WHEN\n",
        "      z.is_sparse\n",
        "    THEN\n",
        "      CONCAT(\n",
        "        'Not enough data to rank: ',\n",
        "        CAST(z.complaints AS STRING),\n",
        "        ' complaints, ',\n",
        "        CAST(z.restaurants AS STRING),\n",
        "        ' restaurants.'\n",
        "      )\n",
        "    ELSE\n",
        "      CONCAT(\n",
        "        'Service Gap Index ',\n",
        "        CAST(CAST(z.sgi AS INT) AS STRING),\n",
        "        ' / 100 — rank ',\n",
        "        CAST(z.sgi_rank AS STRING),\n",
        "        ' of ',\n",
        "        CAST(z.ranked_zip_count AS STRING),\n",
        "        ' NYC ZIPs.'\n",
        "      )\n",
        "  END AS header_sentence\n",
        "FROM\n",
        "  params p\n",
        "    LEFT JOIN workspace.default.zip_service_gap_ranked z\n",
        "      ON z.zip = p.search_zip"
      ],
      "parameters": [
        {
          "displayName": "ZIP Code",
          "keyword": "zip",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "11201"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "complaints_monthly",
      "displayName": "Complaints by Month",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('month', created_at) AS month,\n",
        "  COUNT(*) AS complaints,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN auto_closed THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS closed_without_visit\n",
        "FROM\n",
        "  workspace.default.rodent_complaints_clean\n",
        "WHERE\n",
        "  zip = :zip\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  1"
      ],
      "parameters": [
        {
          "displayName": "ZIP Code",
          "keyword": "zip",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "11201"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "restaurants_list",
      "displayName": "Restaurants with Rodent Evidence",
      "queryLines": [
        "SELECT\n",
        "  restaurant_name,\n",
        "  cuisine,\n",
        "  inspections,\n",
        "  last_inspection_date\n",
        "FROM\n",
        "  workspace.default.restaurants\n",
        "WHERE\n",
        "  zip = :zip\n",
        "  AND has_rodent_evidence\n",
        "ORDER BY\n",
        "  last_inspection_date DESC\n",
        "LIMIT 15"
      ],
      "parameters": [
        {
          "displayName": "ZIP Code",
          "keyword": "zip",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "11201"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "citywide_ctx",
      "displayName": "Citywide SGI Context",
      "queryLines": [
        "SELECT zip, sgi,\n",
        "  CASE WHEN zip = :zip THEN 'Selected ZIP' ELSE 'Other ZIPs' END AS is_selected\n",
        "FROM workspace.default.zip_service_gap_ranked\n",
        "WHERE sgi IS NOT NULL\n",
        "ORDER BY sgi DESC\n",
        "LIMIT 15"
      ],
      "parameters": [
        {
          "displayName": "ZIP Code",
          "keyword": "zip",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "11201"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "b464b0e5",
      "displayName": "Top 10 ZIPs by Raw Complaint Count vs. Capped Complaints",
      "queryLines": [
        "\n",
        "SELECT \n",
        "  zip, \n",
        "  borough, \n",
        "  complaints, \n",
        "  complaints_capped, \n",
        "  top_address_complaints, \n",
        "  top_address_share,\n",
        "  distinct_addresses,\n",
        "  restaurants,\n",
        "  complaints_per_restaurant\n",
        "FROM workspace.default.zip_service_gap_index \n",
        "ORDER BY complaints DESC \n",
        "LIMIT 10\n"
      ]
    }
  ],
